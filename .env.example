# ---------- obrigatórias ----------
# URL pública com HTTPS (o domínio configurado no Dokploy). Usada como issuer do OAuth e na URL do MCP.
PUBLIC_URL=https://voz.seudominio.com
# Gere com: openssl rand -base64 48
SECRET_KEY=
# Segredo compartilhado entre a API e o serviço de inferência. Gere com: openssl rand -hex 32
INFERENCE_TOKEN=

# ---------- primeiro acesso ----------
# Cria o administrador na primeira subida (depois pode remover a senha daqui).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true = qualquer pessoa pode criar conta. false = só o admin cria usuários.
ALLOW_SIGNUP=false

# ---------- opcionais ----------
APP_NAME=Estúdio de Voz
MAX_TEXT_CHARS=5000
# Restringe para onde o OAuth pode redirecionar (recomendado em produção):
# OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,localhost,127.0.0.1

# ---------- motor de voz ----------
# Modelos: mtl-v3 (23 idiomas), pt-br (finetune PT-BR), turbo (inglês), nano (inglês, leve)
ENABLED_MODELS=mtl-v3,pt-br,nano
DEFAULT_MODEL=mtl-v3
PRELOAD_MODELS=mtl-v3
# Quantos modelos ficam na memória ao mesmo tempo (cada um de 500M usa ~4 GB de RAM em CPU)
MAX_LOADED_MODELS=1
# Threads do PyTorch (padrão: todos os núcleos)
TORCH_NUM_THREADS=
# Para usar um worker com GPU em outra máquina, aponte a API para ele:
# INFERENCE_URL=https://gpu-worker.seudominio.com
# TORCH_INDEX=https://download.pytorch.org/whl/cu124
